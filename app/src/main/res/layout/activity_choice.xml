<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/screen_padding"
    tools:context=".ChoiceActivity">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:text="@string/choice_back" />

    <LinearLayout
        android:id="@+id/choiceContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnBack"
        android:layout_above="@id/choiceActions"
        android:layout_marginStart="@dimen/choice_content_margin"
        android:layout_marginEnd="@dimen/choice_content_margin"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTurn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/choice_title_gap"
            android:gravity="center"
            android:text="@string/choice_turn_placeholder"
            android:textSize="@dimen/choice_title_size"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choice_rock"
            android:textAllCaps="false"
            android:textSize="@dimen/choice_button_text_size" />

        <Button
            android:id="@+id/btnScissors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/choice_button_gap"
            android:text="@string/choice_scissors"
            android:textAllCaps="false"
            android:textSize="@dimen/choice_button_text_size" />

        <Button
            android:id="@+id/btnPaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/choice_button_gap"
            android:text="@string/choice_paper"
            android:textAllCaps="false"
            android:textSize="@dimen/choice_button_text_size" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/choiceActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choice_next"
            android:textAllCaps="false"
            android:textSize="@dimen/choice_button_text_size"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnShowResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choice_show_result"
            android:textAllCaps="false"
            android:textSize="@dimen/choice_button_text_size"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>