<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="@dimen/screen_padding"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btnExit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:textSize="@dimen/main_button_text_size"
        android:text="@string/main_exit" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/main_large_gap"
        android:text="@string/app_name"
        android:textSize="@dimen/main_title_size"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/main_large_gap"
        android:paddingStart="@dimen/main_modes_padding"
        android:paddingEnd="@dimen/main_modes_padding"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnBotMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/main_button_gap"
            android:paddingStart="@dimen/main_mode_button_padding"
            android:paddingEnd="@dimen/main_mode_button_padding"
            android:text="@string/main_bot_mode"
            android:textSize="@dimen/main_button_text_size"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnPlayersMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/main_button_gap"
            android:paddingStart="@dimen/main_mode_button_padding"
            android:paddingEnd="@dimen/main_mode_button_padding"
            android:text="@string/main_players_mode"
            android:textSize="@dimen/main_button_text_size"
            android:textAllCaps="false" />

    </LinearLayout>

    <EditText
        android:id="@+id/etPlayer1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/main_large_gap"
        android:hint="@string/main_player1_hint"
        android:inputType="textPersonName"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etPlayer2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/main_button_gap"
        android:hint="@string/main_player2_hint"
        android:inputType="textPersonName"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/main_start_gap"
        android:text="@string/main_start"
        android:visibility="gone" />

</LinearLayout>